{
  "name": "vscode-node-test-explorer",
  "displayName": "Modern node:test Explorer",
  "version": "0.0.19",
  "private": true,
  "description": "VS Code test integration for modern ESM node:test projects.",
  "categories": [
    "Testing"
  ],
  "keywords": [
    "node:test",
    "nodejs",
    "test explorer",
    "testing",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Kaan Ozdokmeci",
    "email": "kaan@2h2d.co",
    "url": "https://www.2h2d.co"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/2h2d-co/vscode-node-test-explorer.git"
  },
  "publisher": "2h2d",
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "typecheck": "tsc --noEmit -p . && tsc -p scripts/tsconfig.json",
    "test": "node --test --test-concurrency=1 scripts/*.test.ts",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "hk check --all --check",
    "build:release": "node scripts/build-release.ts",
    "package": "pnpm compile && node scripts/package-vsix.ts",
    "package:all": "pnpm compile && node scripts/package-vsix.ts --all-targets",
    "package:pre-release": "pnpm compile && node scripts/package-vsix.ts --pre-release",
    "package:pre-release:all": "pnpm compile && node scripts/package-vsix.ts --all-targets --pre-release",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@ast-grep/napi": "0.45.1"
  },
  "devDependencies": {
    "@2h2d/oxlint-config": "0.1.1",
    "@2h2d/ts-config": "0.0.1",
    "@types/node": "22.20.1",
    "@types/vscode": "1.134.0",
    "@vscode/vsce": "3.9.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "vscode-node-test-explorer.refresh",
        "category": "Modern node:test Explorer",
        "title": "Refresh Tests"
      }
    ],
    "configuration": {
      "title": "Modern node:test Explorer",
      "properties": {
        "vscode-node-test-explorer.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node 22.19 or newer executable used for test execution. The extension does not discover or activate version managers."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.134.0"
  },
  "packageManager": "pnpm@11.22.0",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Test discovery is available in Restricted Mode, but running tests requires trusting the workspace because it executes workspace code.",
      "restrictedConfigurations": [
        "vscode-node-test-explorer.nodePath"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Modern node:test Explorer requires local files and a local Node.js executable to discover and run tests."
    }
  }
}
